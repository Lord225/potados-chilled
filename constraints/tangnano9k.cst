// Tang Nano 9K (GW1NR-LV9QN88PC6/I5), 27 MHz oscillator.
IO_LOC  "clk" 52;
IO_PORT "clk" PULL_MODE=UP;

// The six board LEDs are active-low.
IO_LOC  "led[0]" 10;
IO_LOC  "led[1]" 11;
IO_LOC  "led[2]" 13;
IO_LOC  "led[3]" 14;
IO_LOC  "led[4]" 15;
IO_LOC  "led[5]" 16;

// Buttons are active-low and idle high.
IO_LOC  "btn1" 4;
IO_PORT "btn1" PULL_MODE=UP;
IO_LOC  "btn2" 3;
IO_PORT "btn2" PULL_MODE=UP;
