{
  "comments": {
    "lineComment": ";"
  },
  "brackets": [
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    {"open": "[", "close": "]"},
    {"open": "(", "close": ")"},
    {"open": "\"", "close": "\"", "notIn": ["string", "comment"]},
    {"open": "'", "close": "'", "notIn": ["string", "comment"]}
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "wordPattern": "(-?0[xX][0-9A-Fa-f_]+|-?0[bB][01_]+|-?[0-9][0-9_]*|[%A-Za-z_][%A-Za-z0-9_]*)",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*[A-Za-z_][A-Za-z0-9_]*:\\s*(?:[;#].*)?$",
    "decreaseIndentPattern": "^\\s*$"
  }
}
